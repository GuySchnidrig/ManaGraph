# Commander-legal Elves, including every card with Changeling.
# Changeling cards get all creature types through the inferred triples
# (types.ttl axiom, CR 702.73a), so no special case is needed.
PREFIX mg:       <https://w3id.org/managraph/ontology#>
PREFIX creature: <https://w3id.org/managraph/type/creature/>
PREFIX format:   <https://w3id.org/managraph/format/>

SELECT ?name WHERE {
  ?card mg:legalIn format:commander ;
        mg:hasFace/mg:hasSubtype creature:Elf ;
        mg:name ?name .
}
ORDER BY ?name
