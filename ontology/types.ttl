# --- Changeling (702.73a) ---
#
# "Changeling" means "This object is every creature type." A face of a card
# with changeling that is a creature or kindred has every creature type. The
# card-type condition follows 205.3d: an object can't have a subtype that
# doesn't correspond to one of its card types.

[ a owl:Class ;
  owl:intersectionOf (
    [ a owl:Restriction ; owl:onProperty mg:faceOf ;
      owl:someValuesFrom [ a owl:Restriction ; owl:onProperty mg:hasKeyword ;
                           owl:hasValue keyword:changeling ] ]
    [ a owl:Restriction ; owl:onProperty mg:hasCardType ;
      owl:someValuesFrom [ a owl:Class ; owl:oneOf ( cardtype:Creature cardtype:Kindred ) ] ]
  ) ]
  rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Advisor ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Aenar ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Aetherborn ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Alien ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Ally ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Andorian ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Android ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Angel ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Antelope ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Ape ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Archer ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Archon ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Armadillo ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Army ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Artificer ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Assassin ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Assembly-Worker ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Astartes ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Atog ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Aurochs ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Avatar ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Azra ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Badger ] ,
    [ a owl:Restriction ; owl:onProperty mg:hasSubtype ; owl:hasValue creature:Bajoran ] ,
